<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native-only NuGet package: LiteRT-LM for iOS. Unlike desktop, iOS does not honor
    runtimes/<rid>/native; the native library ships as Google's official CLiteRTLM.xcframework
    (device + simulator slices, packed unchanged) and is injected into net10.0-ios consumers as a
    NativeReference Kind=Framework by the buildTransitive .targets below. The .NET-for-iOS build
    embeds + code-signs it into the app bundle; NativeLibraryResolver (managed package) loads it at
    runtime. Pair with the managed LiteRtLmSharp package (same version).
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <PackageId>LiteRtLmSharp.runtime.ios-arm64</PackageId>
    <Description>Native LiteRT-LM runtime (iOS) for LiteRtLmSharp: Google's official CLiteRTLM.xcframework injected via NativeReference (CPU backend). PREVIEW: build/link is validated in CI, but on-device execution is not yet validated — not for production until a hardware-validated release. Official LiteRT-LM $(LiteRtLmVersion) prebuilt. $(LiteRtLmDisclaimer)</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Auto-imported by all consumers (TFM-agnostic buildTransitive root); the .targets itself
         gates the NativeReference items on the iOS platform, so it is a no-op elsewhere. Placed at
         the root rather than buildTransitive/net10.0-ios/ to avoid NU1012 (a platform-versioned
         TFM folder would be required for net10.0-ios). -->
    <None Include="buildTransitive\LiteRtLmSharp.runtime.ios-arm64.targets"
          Pack="true"
          PackagePath="buildTransitive\LiteRtLmSharp.runtime.ios-arm64.targets" />

    <!-- The xcframework, packed next to the .targets (which references it via $(MSBuildThisFileDirectory)).
         Laid into runtimes/ios-arm64/xcframeworks/ by native-release.yml (gitignored, restored before pack). -->
    <!-- PackagePath is the directory only: for a recursive glob NuGet appends %(RecursiveDir)%(Filename)%(Extension)
         itself, and adding %(RecursiveDir) here as well doubled every path inside the package
         (xcframeworks/X.xcframework/X.xcframework/...), which the layout assertion in ios-package-check.yml now catches. -->
    <None Include="..\..\runtimes\ios-arm64\xcframeworks\**\*"
          Pack="true"
          PackagePath="buildTransitive\xcframeworks\" />
  </ItemGroup>

  <!-- Upstream's third-party notices for the official binaries (a native-release.yml asset, laid into
       runtimes/ by pack-nuget.yml and scripts/restore-natives.ps1). Packed at the package root. -->
  <ItemGroup>
    <None Include="..\..\runtimes\THIRD_PARTY_NOTICES.litert-lm.txt"
          Pack="true"
          PackagePath=""
          Condition="Exists('..\..\runtimes\THIRD_PARTY_NOTICES.litert-lm.txt')" />
  </ItemGroup>

</Project>
