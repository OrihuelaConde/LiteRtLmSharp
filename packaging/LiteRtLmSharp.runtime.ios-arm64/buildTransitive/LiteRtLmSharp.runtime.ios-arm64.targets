<Project>

  <!--
    Auto-imported into net10.0-ios consumers of LiteRtLmSharp.runtime.ios-arm64.

    The LiteRT-LM natives ship as dynamic .framework xcframeworks (LiteRt is static inside
    libLiteRtLm; the 3 Google prebuilt companions stay dynamic — they have no static archives).
    Referencing them as NativeReference Kind=Framework makes the .NET-for-iOS build EMBED and
    code-sign each framework into the app bundle. We resolve them at runtime via dlopen
    (NativeLibraryResolver in the managed package), so SmartLink=False keeps the frameworks whole
    instead of dead-stripping symbols that are only referenced dynamically.

    Device-arm64 only: the companions have no iOS Simulator slice, so a simulator build cannot
    link this set. See docs/roadmap.md ("Architecture decisions") and docs/packaging.md.
  -->
  <PropertyGroup>
    <_LiteRtLmXcfDir>$(MSBuildThisFileDirectory)xcframeworks\</_LiteRtLmXcfDir>
  </PropertyGroup>

  <ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
    <NativeReference Include="$(_LiteRtLmXcfDir)LiteRtLm.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
    <NativeReference Include="$(_LiteRtLmXcfDir)GemmaModelConstraintProvider.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
    <NativeReference Include="$(_LiteRtLmXcfDir)LiteRtMetalAccelerator.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
    <NativeReference Include="$(_LiteRtLmXcfDir)LiteRtTopKMetalSampler.xcframework">
      <Kind>Framework</Kind>
      <SmartLink>False</SmartLink>
    </NativeReference>
  </ItemGroup>

</Project>
