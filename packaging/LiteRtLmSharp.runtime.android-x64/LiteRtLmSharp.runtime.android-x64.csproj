<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Native-only NuGet package: LiteRT-LM android-x64 (.so) under runtimes/android-x64/native/, for the
    x86_64 Android emulator. .NET Android (net8+) bundles runtimes/<rid>/native/*.so from packages into
    the APK (lib/x86_64/). One file: Google's official monolithic library, renamed libLiteRtLm.so by
    native-release.yml.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>$(NoWarn);NU5128</NoWarn>

    <PackageId>LiteRtLmSharp.runtime.android-x64</PackageId>
    <Description>Native LiteRT-LM runtime (android-x64) for LiteRtLmSharp. Built from LiteRT-LM $(LiteRtLmVersion). $(LiteRtLmDisclaimer)</Description>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\runtimes\android-x64\native\*"
          Pack="true"
          PackagePath="runtimes\android-x64\native\" />
  </ItemGroup>

  <!-- Upstream's third-party notices for the official binaries (a native-release.yml asset, laid into
       runtimes/ by pack-nuget.yml and scripts/restore-natives.ps1). Packed at the package root. -->
  <ItemGroup>
    <None Include="..\..\runtimes\THIRD_PARTY_NOTICES.litert-lm.txt"
          Pack="true"
          PackagePath=""
          Condition="Exists('..\..\runtimes\THIRD_PARTY_NOTICES.litert-lm.txt')" />
  </ItemGroup>

</Project>
