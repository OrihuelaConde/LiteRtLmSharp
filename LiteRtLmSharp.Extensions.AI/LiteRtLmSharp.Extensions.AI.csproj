<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!-- Ship the XML doc file so the public API surface appears in consumers' IntelliSense. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!--
      Microsoft.Extensions.AI (MEAI) integration for LiteRtLmSharp: an IChatClient implementation
      (LiteRtChatClient). This is the foundational, framework-agnostic integration — it works directly with
      Microsoft Agent Framework (ChatClientAgent), Semantic Kernel (via the LiteRtLmSharp.SemanticKernel
      package), and any IChatClient consumer. Depends only on the MEAI abstractions plus
      Microsoft.Extensions.DependencyInjection.Abstractions (for the DI helpers).
    -->
    <PackageId>LiteRtLmSharp.Extensions.AI</PackageId>
    <Description>Microsoft.Extensions.AI (IChatClient) integration for LiteRtLmSharp on-device LLM inference. Works with Microsoft Agent Framework, Semantic Kernel, and any IChatClient consumer. Companion to the LiteRtLmSharp package. $(LiteRtLmDisclaimer)</Description>
    <PackageTags>litert;litert-lm;microsoft-extensions-ai;ichatclient;agent-framework;semantic-kernel;llm;gemma;on-device;inference;ai</PackageTags>

    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.7.0" />
    <!-- For the AddLiteRtChatClient DI helpers (IServiceCollection). MEAI.Abstractions does not pull this
         in transitively. -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiteRtLmSharp\LiteRtLmSharp.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LiteRtLmSharp.Tests" />
    <!-- The Semantic Kernel connector reuses the option-bag coercion helpers (one contract for both connectors). -->
    <InternalsVisibleTo Include="LiteRtLmSharp.SemanticKernel" />
  </ItemGroup>

</Project>
