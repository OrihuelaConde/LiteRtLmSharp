<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <LangVersion>latest</LangVersion>

    <!-- Ship the XML doc file so the public API surface appears in consumers' IntelliSense. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Pure managed package. Native binaries ship in LiteRtLmSharp.runtime.<rid> packages. -->
    <PackageId>LiteRtLmSharp</PackageId>
    <Description>.NET binding for Google's LiteRT-LM on-device LLM inference (P/Invoke over the C API). Add a LiteRtLmSharp.runtime.&lt;rid&gt; package for native binaries. $(LiteRtLmDisclaimer)</Description>

    <!-- Debugger source mapping for the published package (SourceLink ships with the SDK). -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <!-- The test project unit-tests internal JSON builders (e.g. LiteRtJson.ExtraContext) directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="LiteRtLmSharp.Tests" />
  </ItemGroup>

  <!--
    Local dev only: copy the native LiteRT-LM runtime next to the managed assembly so the sample
    and tests resolve it. These come from runtimes/<rid>/native/ (gitignored; produced by
    build-native.yml or scripts/restore-natives.ps1). Pack=false — they are NOT in this package;
    they are distributed via the separate LiteRtLmSharp.runtime.<rid> packages.
  -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) And Exists('..\runtimes\win-x64\native')">
    <None Include="..\runtimes\win-x64\native\*.dll" Pack="false">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Linux')) And Exists('..\runtimes\linux-x64\native')">
    <None Include="..\runtimes\linux-x64\native\*.so" Pack="false">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX')) And Exists('..\runtimes\osx-arm64\native')">
    <None Include="..\runtimes\osx-arm64\native\*.dylib" Pack="false">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
