<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
    <PackageReference Include="Xunit.SkippableFact" Version="1.5.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LiteRtLmSharp\LiteRtLmSharp.csproj" />
    <ProjectReference Include="..\LiteRtLmSharp.SemanticKernel\LiteRtLmSharp.SemanticKernel.csproj" />
  </ItemGroup>

  <!-- A real 5->0 spoken countdown, embedded so the gated audio model test has a meaningful clip
       (the model can actually transcribe it) with no fixture-path or platform concerns. -->
  <ItemGroup>
    <EmbeddedResource Include="testdata\countdown.mp3">
      <LogicalName>countdown.mp3</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
