<Solution>
  <!--
    Samples solution: open this one to build/run the samples. The MAUI sample requires the
    MAUI workloads (dotnet workload install maui). The library project is included so you can
    step into the binding while debugging; the main LiteRtLmSharp.slnx (lib + tests + packaging)
    builds with the bare .NET SDK and is what CI uses.
  -->
  <Project Path="../LiteRtLmSharp/LiteRtLmSharp.csproj" />
  <Project Path="Console/LiteRtLmSharp.Sample.csproj" />
  <Project Path="Maui/LiteRtLmSharp.SampleMaui.csproj" />
</Solution>
