<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="LiteLMSharp.SampleMaui.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:pages="clr-namespace:LiteLMSharp.SampleMaui.Pages"
    Title="LiteLMSharp">

    <TabBar>
        <ShellContent
            Title="Models"
            ContentTemplate="{DataTemplate pages:ModelsPage}"
            Route="ModelsPage" />
        <ShellContent
            Title="Chat"
            ContentTemplate="{DataTemplate pages:ChatPage}"
            Route="ChatPage" />
        <ShellContent
            Title="Tools"
            ContentTemplate="{DataTemplate pages:ToolsPage}"
            Route="ToolsPage" />
    </TabBar>

</Shell>
