<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:pages="clr-namespace:LiteRtLmSharp.SampleMaui.Pages"
             x:Class="LiteRtLmSharp.SampleMaui.Pages.ChatPage"
             x:DataType="pages:ChatPage"
             Title="Chat">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="New" Clicked="OnNewConversation" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto,Auto" Padding="12" RowSpacing="8">

        <Label x:Name="HeaderLabel"
               Grid.Row="0"
               Text="No model loaded — pick one in the Models tab."
               FontSize="13"
               TextColor="Gray" />

        <!-- ScrollView + BindableLayout instead of CollectionView: on Windows, CollectionView
             re-virtualizes (visibly flickers) every time an item is added or the streaming
             reply grows. A chat demo holds few messages, so virtualization buys nothing. -->
        <ScrollView x:Name="MessagesScroll" Grid.Row="1">
            <VerticalStackLayout x:Name="MessagesStack"
                                 BindableLayout.ItemsSource="{Binding Messages}">
                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="pages:ChatMessage">
                        <Border Margin="0,4" Padding="10" StrokeThickness="0"
                                StrokeShape="RoundRectangle 10"
                                BackgroundColor="{Binding Background}"
                                HorizontalOptions="{Binding Alignment}"
                                MaximumWidthRequest="540">
                            <VerticalStackLayout Spacing="3">
                                <!-- Attached image (user turns), shown above the text. Fixed height +
                                     AspectFit scales it down to a thumbnail preserving aspect ratio
                                     (a MaximumHeightRequest alone is not honored reliably, leaving the
                                     image huge/clipped); the bubble's MaximumWidthRequest bounds the width. -->
                                <Image Source="{Binding AttachmentImage}" IsVisible="{Binding HasImage}"
                                       Aspect="AspectFit" HeightRequest="160"
                                       HorizontalOptions="Start" />
                                <!-- Attached audio (or a file with no thumbnail): a small chip. -->
                                <Label Text="{Binding AttachmentLabel}" IsVisible="{Binding HasAttachmentLabel}"
                                       FontSize="12" TextColor="Gray" />
                                <!-- Reasoning trace (only when EnableThinking produced one), dimmed above the answer. -->
                                <Label Text="💭 thinking" IsVisible="{Binding HasThinking}"
                                       FontSize="11" TextColor="Gray" />
                                <Label Text="{Binding ThinkingText}" IsVisible="{Binding HasThinking}"
                                       FontSize="13" FontAttributes="Italic" TextColor="Gray" LineBreakMode="WordWrap" />
                                <Label Text="{Binding Text}" IsVisible="{Binding HasText}"
                                       FontSize="15" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>
        </ScrollView>

        <Label x:Name="GaugeLabel" Grid.Row="2" FontSize="11" TextColor="Gray" IsVisible="False" />

        <VerticalStackLayout Grid.Row="3" Spacing="6">
            <!-- Pending attachment preview: a thumbnail (image) or a chip (audio), with a remove button.
                 Hidden until the user attaches something. -->
            <Border x:Name="AttachmentPreview" IsVisible="False" Padding="6" StrokeThickness="0"
                    StrokeShape="RoundRectangle 8" BackgroundColor="{AppThemeBinding Light=#F1F1F1, Dark=#333333}"
                    HorizontalOptions="Start">
                <HorizontalStackLayout Spacing="8">
                    <Image x:Name="AttachThumb" IsVisible="False" HeightRequest="40" WidthRequest="40" Aspect="AspectFill" />
                    <Label x:Name="AttachLabel" VerticalOptions="Center" FontSize="13" TextColor="Gray" />
                    <Button Text="✕" Clicked="OnClearAttachment" Padding="0" WidthRequest="32" HeightRequest="32"
                            BackgroundColor="Transparent" TextColor="Gray" FontSize="14" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Border>

            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="6">
                <!-- Attach buttons; shown only when the loaded model supports that modality. -->
                <Button x:Name="AttachImageButton" Grid.Column="0" Text="📷" IsVisible="False" IsEnabled="False"
                        Clicked="OnAttachImage" WidthRequest="44" Padding="0" />
                <Button x:Name="AttachAudioButton" Grid.Column="1" Text="🎵" IsVisible="False" IsEnabled="False"
                        Clicked="OnAttachAudio" WidthRequest="44" Padding="0" />
                <Entry x:Name="InputEntry" Grid.Column="2"
                       Placeholder="Type a message…"
                       IsEnabled="False"
                       Completed="OnSend" />
                <Button x:Name="SendButton" Grid.Column="3" Text="Send" IsEnabled="False" Clicked="OnSend" />
                <Button x:Name="StopButton" Grid.Column="4" Text="Stop" IsVisible="False" Clicked="OnStop" />
            </Grid>
        </VerticalStackLayout>

    </Grid>
</ContentPage>
