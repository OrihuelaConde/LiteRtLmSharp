<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!--
		  Primary target: Android (physical arm64 device). Windows is included so the same app
		  runs on desktop. iOS (net10.0-ios) is gated to macOS hosts ONLY: building the iOS TFM
		  requires a paired Mac, so listing it on Windows would break the build — on Windows this
		  project stays Android + Windows exactly as before. iOS is device-arm64 only (the native
		  companions have no simulator slice). MacCatalyst is out of scope — upstream ships no
		  maccatalyst (-macabi) native slice; macOS is served by the osx-arm64 package (console /
		  net*-macos apps), which MAUI cannot consume.
		-->
		<TargetFrameworks>net10.0-android</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('osx'))">$(TargetFrameworks);net10.0-ios</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>LiteRtLmSharp.SampleMaui</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<IsPackable>false</IsPackable>

		<ApplicationTitle>LiteRtLmSharp</ApplicationTitle>
		<ApplicationId>com.litertlmsharp.sample</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<WindowsPackageType>None</WindowsPackageType>

		<!-- LiteRT-LM requires Android API 24+ (and targetSdk 35 per Google's checklist). -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<!-- iOS min OS matches the native binaries (companions vtool'd to minos 16.0). Device-arm64 only. -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">16.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

		<!-- We only ship arm64 native binaries (physical devices). -->
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64</RuntimeIdentifiers>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">ios-arm64</RuntimeIdentifiers>
	</PropertyGroup>

	<ItemGroup>
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#512BD4" />
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\*" />
		<MauiFont Include="Resources\Fonts\*" />
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<!--
	  The samples intentionally reference the library by project so they always build and test
	  the current source tree (CI relies on this). Native binaries come from runtimes/<rid>/native
	  (restore them first — see scripts/restore-natives.ps1 and the native-v* GitHub release).
	  Consumers should instead use the published packages — see the PackageReference snippet in
	  the repo README:
	    <PackageReference Include="LiteRtLmSharp" ... />
	    <PackageReference Include="LiteRtLmSharp.runtime.android-arm64" ... />  (etc.)
	-->
	<ItemGroup>
		<ProjectReference Include="..\..\LiteRtLmSharp\LiteRtLmSharp.csproj" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<!--
		  Full native set. GPU on Android REQUIRES the <uses-native-library> declarations in
		  AndroidManifest.xml (Android 12+): without libOpenCL.so access the registry silently
		  falls back to the Dawn/Vulkan accelerator, whose shaders fail on older Adreno drivers
		  and produce garbage output. With the manifest fix the registry prefers OpenCL
		  (verified on a Moto G100 / Adreno 650 / Android 12).
		  Known harmless: the prebuilt TopK samplers fail to dlopen (missing DT_NEEDED on
		  libLiteRtLm.so: "cannot locate symbol LiteRtCreateEnvironment") so sampling runs on
		  CPU; matmuls stay on GPU. Fixable with patchelf in the native build (flutter_gemma #270).
		-->
		<AndroidNativeLibrary Include="..\..\runtimes\android-arm64\native\*.so"
		                      Abi="arm64-v8a" />
	</ItemGroup>

	<!--
	  iOS: the natives ship as embedded dynamic .frameworks (NativeReference Kind=Framework). The
	  sample references the lib by project, so it injects the NativeReferences here directly (the
	  published LiteRtLmSharp.runtime.ios-arm64 package does the same via a buildTransitive
	  .targets). Restore the xcframeworks first (the native-v* release / restore-natives.ps1).
	  RUNTIME NOTE: on-device companion dlopen resolution is pending the hardware-validation phase
	  (see build-native.yml); build/link works without it.
	-->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios' And Exists('..\..\runtimes\ios-arm64\xcframeworks')">
		<NativeReference Include="..\..\runtimes\ios-arm64\xcframeworks\LiteRtLm.xcframework"><Kind>Framework</Kind><SmartLink>False</SmartLink></NativeReference>
		<NativeReference Include="..\..\runtimes\ios-arm64\xcframeworks\GemmaModelConstraintProvider.xcframework"><Kind>Framework</Kind><SmartLink>False</SmartLink></NativeReference>
		<NativeReference Include="..\..\runtimes\ios-arm64\xcframeworks\LiteRtMetalAccelerator.xcframework"><Kind>Framework</Kind><SmartLink>False</SmartLink></NativeReference>
		<NativeReference Include="..\..\runtimes\ios-arm64\xcframeworks\LiteRtTopKMetalSampler.xcframework"><Kind>Framework</Kind><SmartLink>False</SmartLink></NativeReference>
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<None Include="..\..\runtimes\win-x64\native\*.dll" Condition="Exists('..\..\runtimes\win-x64\native')">
			<Link>%(Filename)%(Extension)</Link>
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
