<Project Sdk="Microsoft.NET.Sdk">
  <!-- External consumer smoke for pack-nuget.yml: consumes the just-packed .nupkg files from a
       local feed (see nuget.config — the `feed/` folder at the repo root) exactly as a real
       framework-dependent app would, i.e. through the NuGet runtimes/<rid>/native layout, NOT the
       repo's flat dev copy. The package version under test is passed by the workflow via
       -p:LiteRtLmSharpVersion. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RestorePackagesPath>packages</RestorePackagesPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="LiteRtLmSharp" Version="$(LiteRtLmSharpVersion)" />
    <PackageReference Include="LiteRtLmSharp.runtime.win-x64" Version="$(LiteRtLmSharpVersion)" />
    <PackageReference Include="LiteRtLmSharp.Extensions.AI" Version="$(LiteRtLmSharpVersion)" />
    <PackageReference Include="LiteRtLmSharp.SemanticKernel" Version="$(LiteRtLmSharpVersion)" />
    <PackageReference Include="Microsoft.SemanticKernel" Version="1.77.0" />
  </ItemGroup>
</Project>
