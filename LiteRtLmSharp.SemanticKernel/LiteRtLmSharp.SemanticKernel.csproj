<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>

    <!--
      Microsoft Semantic Kernel connector for LiteRtLmSharp. Pure managed: a thin layer over the
      LiteRtLmSharp.Extensions.AI IChatClient, exposed to Semantic Kernel via the AsChatCompletionService
      adapter. NOT marked AOT/trim-clean (Semantic Kernel itself is not); the core LiteRtLmSharp package stays AOT.
    -->
    <PackageId>LiteRtLmSharp.SemanticKernel</PackageId>
    <Description>Microsoft Semantic Kernel connector (IChatCompletionService) for LiteRtLmSharp on-device LLM inference — a thin layer over the LiteRtLmSharp.Extensions.AI IChatClient. Companion to the LiteRtLmSharp package. $(LiteRtLmDisclaimer)</Description>
    <PackageTags>litert;litert-lm;semantic-kernel;llm;gemma;on-device;inference;ai</PackageTags>

    <!-- Debugger source mapping for the published package (SourceLink ships with the SDK). -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SemanticKernel.Abstractions" Version="1.77.0" />
  </ItemGroup>

  <!-- Project references within the repo; become NuGet dependencies (same version, via Directory.Build.props)
       when this project is packed. This connector is a thin layer over the LiteRtLmSharp.Extensions.AI
       IChatClient (exposed to Semantic Kernel via AsChatCompletionService). -->
  <ItemGroup>
    <ProjectReference Include="..\LiteRtLmSharp\LiteRtLmSharp.csproj" />
    <ProjectReference Include="..\LiteRtLmSharp.Extensions.AI\LiteRtLmSharp.Extensions.AI.csproj" />
  </ItemGroup>

</Project>
