<Project>

  <!--
    Shared metadata for all LiteRtLmSharp packages. The package version is independent of the
    LiteRT-LM native version (pinned via LiteRtLmVersion below): bump minor for native bumps or
    new features, patch for binding-only fixes. The managed package and every
    LiteRtLmSharp.runtime.<rid> package always share the same version and are published together;
    the README compatibility table maps each release to the LiteRT-LM tag it was built against.
  -->
  <PropertyGroup>
    <Version>1.1.1</Version>
    <!-- LiteRT-LM release tag the native binaries are built from (build-native.yml input). -->
    <LiteRtLmVersion>v0.14.0</LiteRtLmVersion>
    <!-- Shown on the nuget.org version page; update each release. Full history in CHANGELOG.md. -->
    <PackageReleaseNotes>1.1.1: fixes GPU engine creation for NuGet consumers on Windows (framework-dependent apps got "litert_lm_engine_create returned null" with Backend=Gpu: the engine's runtime LoadLibrary of the GPU accelerators never searches NuGet's runtimes/win-x64/native folder; the resolver now pre-loads the companion DLLs there, as it already did on Linux/macOS). Managed-only fix — the native binaries are unchanged (LiteRT-LM $(LiteRtLmVersion)). Full notes: https://github.com/OrihuelaConde/LiteRtLmSharp/blob/master/CHANGELOG.md</PackageReleaseNotes>

    <Authors>LiteRtLmSharp contributors</Authors>
    <Company>LiteRtLmSharp</Company>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/OrihuelaConde/LiteRtLmSharp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/OrihuelaConde/LiteRtLmSharp</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>litert;litert-lm;llm;gemma;on-device;inference;ai;maui</PackageTags>
    <!-- Every package embeds a dedicated concise README (shown on nuget.org, which renders no
         HTML — the repo-root README uses an HTML hero). Packed below as README.md. -->
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Appended to every package Description. Keep in sync with NOTICE / README. -->
    <LiteRtLmDisclaimer>Unofficial community bindings, not affiliated with or endorsed by Google. LiteRT is a trademark of Google LLC.</LiteRtLmDisclaimer>
  </PropertyGroup>

  <!-- Ship the README and legal files inside every package (PackagePath="" = nupkg root). -->
  <ItemGroup>
    <None Include="$(MSBuildThisFileDirectory)packaging\nuget-readme.md" Pack="true" PackagePath="README.md" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)LICENSE.txt" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)NOTICE" Pack="true" PackagePath="" Visible="false" />
    <None Include="$(MSBuildThisFileDirectory)THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="" Visible="false" />
  </ItemGroup>

</Project>
